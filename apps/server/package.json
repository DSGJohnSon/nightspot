{
  "name": "@nightspot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "clips:enrich": "tsx --env-file-if-exists=.env scripts/enrich-clips.ts",
    "smoke": "tsx scripts/smoke.ts",
    "data:push": "tsx --env-file-if-exists=.env scripts/data-sync.ts push",
    "data:pull": "tsx --env-file-if-exists=.env scripts/data-sync.ts pull"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@nightspot/shared": "workspace:*",
    "fastify": "^5.12.7",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3"
  }
}
